# Copie para .env e ajuste se precisar — .env nunca é commitado (ver .gitignore).
# Nenhum destes valores é segredo; são limites e caminhos operacionais.

# Aplicação
PORT=8000
LOG_LEVEL=INFO

# Armazenamento
DB_PATH=./data/app.db
UPLOAD_DIR=./data/uploads

# Limites de upload e processamento
MAX_UPLOAD_MB=20
MAX_PAGINAS=50

# OCR
OCR_DPI=300
OCR_CONF_THRESHOLD=65
OCR_MAX_CONCORRENTES=2

# Retenção — política declarada no SOLUCAO.md.
# Varredura best-effort a cada novo upload (não há agendador dedicado no processo).
RETENCAO_HORAS=24
